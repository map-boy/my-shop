rules_version = '2';

// ---------------------------------------------------------------------------
// my-shop — Firestore security rules
//
// Model
//   * Everything the storefront shows is world-readable.
//   * Everything is writable by administrators only.
//   * An administrator is either the bootstrap OWNER (hard-coded below so the
//     very first sign-in always works) or any Google account whose e-mail has
//     a document in /admins/{email}.
//   * Only an OWNER can add/remove administrators.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // The bootstrap super administrator. Keep in sync with VITE_OWNER_EMAIL.
    function ownerEmail() {
      return 'techubwenge@gmail.com';
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(email())).data;
    }

    function adminExists() {
      return exists(/databases/$(database)/documents/admins/$(email()));
    }

    function isAdmin() {
      return signedIn() && (
        email() == ownerEmail() ||
        (adminExists() && adminDoc().get('disabled', false) == false)
      );
    }

    // A seller may only touch rows they own.
    function isSeller() {
      return isAdmin() && adminExists() && adminDoc().get('role', 'seller') == 'seller';
    }

    // The owner and full admins can act on anything; sellers cannot.
    function managesEverything() {
      return isAdmin() && !isSeller();
    }

    function ownsIncoming() {
      return request.resource.data.get('sellerId', '') == email();
    }

    function ownsExisting() {
      return resource.data.get('sellerId', '') == email();
    }

    function isOwner() {
      return signedIn() && (
        email() == ownerEmail() ||
        (adminExists() && adminDoc().get('role', 'admin') == 'owner'
                       && adminDoc().get('disabled', false) == false)
      );
    }

    // An affiliate agent signs in with the Google account stored in agents/{code}.email.
    function isAgentOf(code) {
      return signedIn()
        && code is string && code.size() > 0 && code.size() <= 24
        && exists(/databases/$(database)/documents/agents/$(code))
        && get(/databases/$(database)/documents/agents/$(code)).data.get('email', '') == email();
    }

    // --- Administrators -----------------------------------------------------
    match /admins/{adminEmail} {
      // The owner sees the whole roster. Everyone else sees only themselves,
      // which is all the app needs to decide what to show them.
      allow read: if isOwner() || (signedIn() && adminEmail == email());
      // Bootstrap: the owner may self-provision their own record.
      allow create: if isOwner() || (signedIn() && email() == ownerEmail() && adminEmail == ownerEmail());
      // A seller may fill in their own shop profile, but must not be able to
      // promote themselves or lift their own suspension.
      allow update: if (isOwner() && adminEmail != ownerEmail())
                    || (signedIn() && adminEmail == email()
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.disabled == resource.data.disabled);
      allow delete: if isOwner() && adminEmail != ownerEmail();
    }

    // --- Catalog ------------------------------------------------------------
    match /products/{id} {
      allow read: if true;
      // A seller must stamp their own address on anything they create, and may
      // only change rows already stamped with it. This is what stops one seller
      // reaching another seller's listings — the dashboard filtering is only
      // there to keep the screen tidy.
      allow create: if managesEverything() || (isSeller() && ownsIncoming());
      allow update: if managesEverything() || (isSeller() && ownsExisting() && ownsIncoming());
      allow delete: if managesEverything() || (isSeller() && ownsExisting());
    }

    match /categories/{id} { allow read: if true; allow write: if managesEverything(); }
    match /collections/{id}{ allow read: if true; allow write: if managesEverything(); }
    match /sections/{id}   { allow read: if true; allow write: if managesEverything(); }

    match /coupons/{id} {
      allow read: if true;
      allow create: if managesEverything() || (isSeller() && ownsIncoming());
      allow update: if managesEverything() || (isSeller() && ownsExisting() && ownsIncoming());
      allow delete: if managesEverything() || (isSeller() && ownsExisting());
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if true;                 // shoppers may leave a review
      allow update, delete: if managesEverything();
    }

    // --- Storefront configuration ------------------------------------------
    // Only the platform owner styles the shop and sets the payment details, so
    // every order keeps paying into the one MoMo code.
    match /settings/{id}   { allow read: if true; allow write: if managesEverything(); }
    match /pages/{id}      { allow read: if true; allow write: if managesEverything(); }
    // Auto-translations: read by the storefront, written by signed-in staff (admin save + Translate everything).
    match /translations/{id} { allow read: if true; allow write: if isAdmin(); }

    match /media/{id}      { allow read: if true; allow write: if isAdmin(); }

    // --- Orders -------------------------------------------------------------
    match /orders/{id} {
      // Anyone may place an order (guest checkout).
      allow create: if true;
      // The owner sees everything. A seller sees only orders carrying one of
      // their lines. A signed-in shopper sees their own.
      allow read: if managesEverything()
                  || (isSeller() && email() in resource.data.get('sellerIds', []))
                  || (signedIn() && resource.data.customerEmail == email());
      // Orders can hold items from several sellers, so only the platform
      // changes their status — otherwise one seller could cancel another's
      // items.
      allow update, delete: if managesEverything();
    }

    // --- Customers & inbox --------------------------------------------------
    match /customers/{id} {
      allow read: if managesEverything() || (signedIn() && id == email());
      allow create, update: if true;         // upserted at checkout
      allow delete: if managesEverything();
    }

    match /messages/{id} {
      allow create: if true;                 // contact form
      allow read, update, delete: if managesEverything();
    }

    match /subscribers/{id} {
      allow create: if true;                 // newsletter
      allow read, update, delete: if managesEverything();
    }

    // --- Audit trail --------------------------------------------------------
    match /activity/{id} {
      allow read: if managesEverything();    // the audit trail spans all sellers
      allow create: if isAdmin();            // but everyone writes to it
      allow update, delete: if isOwner();
    }

    // --- Traffic counters -----------------------------------------------------
    // Visitors write anonymously but can only bump a counter by 1 per write.
    // Only staff read; a seller reads only rows stamped with their own address.
    match /traffic/{id} {
      allow read: if managesEverything() || (isSeller() && resource.data.get('sellerId', '') == email());
      allow create: if request.resource.data.keys().hasOnly(['day','slug','sellerId','views','qr','visitors','updatedAt'])
                    && id == request.resource.data.day + '__' + request.resource.data.slug
                    && request.resource.data.get('views', 0) <= 1
                    && request.resource.data.get('qr', 0) <= 1
                    && request.resource.data.get('visitors', 0) <= 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views','qr','visitors','updatedAt'])
                    && request.resource.data.get('views', 0) - resource.data.get('views', 0) <= 1
                    && request.resource.data.get('qr', 0) - resource.data.get('qr', 0) <= 1
                    && request.resource.data.get('visitors', 0) - resource.data.get('visitors', 0) <= 1;
      allow delete: if isOwner();
    }

    // --- Push tokens ------------------------------------------------------------
    // A device registers itself (the token is its key); only staff can read the list.
    match /pushTokens/{id} {
      allow read, delete: if managesEverything();
      allow create, update: if request.resource.data.keys().hasOnly(['token','sellers','lang','updatedAt'])
                            && request.resource.data.token == id
                            && request.resource.data.get('sellers', []).size() <= 20;
    }

    // --- Blog ---------------------------------------------------------------
    // Shoppers read published articles only; drafts are staff-only.
    match /posts/{id} {
      allow read: if resource.data.get('published', false) == true || managesEverything();
      allow write: if managesEverything();
    }

    // --- Affiliate agents ---------------------------------------------------
    // Admin-managed. Visitors may only create/extend their own visit row, and
    // activeSec can never grow faster than real server time (request.time).
    match /agents/{code} {
      // Admin sees all. An agent sees only the profile carrying their own e-mail.
      allow read: if managesEverything() || (signedIn() && resource.data.get('email', '') == email());
      allow write: if managesEverything();
    }
    match /agentVisits/{id} {
      allow read: if managesEverything() || isAgentOf(resource.data.code);
      allow delete: if managesEverything();
      allow create: if request.resource.data.keys().hasOnly(['code','vid','day','startedAt','lastAt','lastServer','activeSec','pages','productViews','scrolled','waClicks','landing','ua'])
                    && id == request.resource.data.vid + '__' + request.resource.data.code + '__' + request.resource.data.day
                    && request.resource.data.code.size() <= 24
                    && request.resource.data.vid.size() <= 40
                    && request.resource.data.lastServer == request.time
                    && request.resource.data.activeSec == 0
                    && request.resource.data.get('pages', 0) <= 1
                    && request.resource.data.get('productViews', 0) <= 1
                    && request.resource.data.get('waClicks', 0) <= 1
                    && exists(/databases/$(database)/documents/agents/$(request.resource.data.code))
                    && get(/databases/$(database)/documents/agents/$(request.resource.data.code)).data.get('active', false) == true;
      allow update: if managesEverything()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt','lastServer','activeSec','pages','productViews','scrolled','waClicks'])
                        && request.resource.data.lastServer == request.time
                        && request.resource.data.activeSec - resource.data.activeSec >= 0
                        && request.resource.data.activeSec - resource.data.activeSec <= (request.time.toMillis() - resource.data.lastServer.toMillis()) / 1000 + 2
                        && request.resource.data.pages - resource.data.pages <= 1
                        && request.resource.data.productViews - resource.data.productViews <= 1
                        && request.resource.data.waClicks - resource.data.waClicks <= 1);
    }
    match /agentLeads/{id} {
      allow read: if managesEverything() || isAgentOf(resource.data.code);
      allow update, delete: if managesEverything();
      allow create: if managesEverything()
                    || (request.resource.data.keys().hasOnly(['code','vid','productId','productName','price','qty','status','amount','note','createdAt'])
                        && request.resource.data.status == 'lead'
                        && request.resource.data.amount == 0
                        && request.resource.data.code.size() <= 24
                        && exists(/databases/$(database)/documents/agents/$(request.resource.data.code))
                        && get(/databases/$(database)/documents/agents/$(request.resource.data.code)).data.get('active', false) == true);
    }
    match /agentPayouts/{id} {
      allow read: if managesEverything() || isAgentOf(resource.data.code);
      allow write: if managesEverything();
    }

    // --- Agent program: rules page config, applications, admin push tokens ---
    match /agentProgram/{id} { allow read: if true; allow write: if managesEverything(); }
    match /agentProgramPrivate/{id} { allow read, write: if managesEverything(); }
    match /adminPushTokens/{id} { allow read, write: if managesEverything(); }
    match /agentApplications/{id} {
      allow read: if managesEverything() || (signedIn() && id == email());
      allow create: if signedIn() && id == email()
                    && request.resource.data.keys().hasOnly(['name','phone','email','note','agreed','status','createdAt'])
                    && request.resource.data.email == email()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.agreed == true
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 24
                    && request.resource.data.get('note', '').size() <= 400;
      allow update, delete: if managesEverything();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
